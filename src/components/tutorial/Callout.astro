---
/**
 * A box of notes set apart from the steps, such as "Why is it slightly
 * under?". `tone="caution"` is for warnings about uncertain numbers.
 */
interface Props {
  title: string;
  tone?: "note" | "caution";
}

const { title, tone = "note" } = Astro.props;
---

<section class:list={["callout", tone]}>
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .callout {
    margin-block: var(--space-4);
    padding: var(--space-3);
    border-inline-start: 4px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    background: var(--color-background-subtle);
  }

  .caution {
    border-color: var(--color-warning);
    background: var(--color-warning-background);
  }

  h2 {
    margin-block-end: var(--space-2);
    font-size: 1.125rem;
  }

  .callout :global(:last-child) {
    margin-block-end: 0;
  }
</style>
