---
/**
 * A numbered step: its formulas and a one-line reason on the left, and the
 * chosen formula's worked example on the right. They stack when the card is
 * narrow.
 *
 * Slots:
 * - default: the step's content, usually a `Formula`.
 * - `example`: one `WorkedExample` per formula on the follow-along switch.
 */
interface Props {
  number: number | string;
  title: string;
  /** One line on why the step works, shown under the formulas. */
  reason?: string;
}

const { number, title, reason } = Astro.props;
---

<section class="step-card">
  <div class="layout">
    <div class="method">
      <h2>
        <span class="number"><span class="visually-hidden">Step </span>{number}</span>{" "}
        {title}
      </h2>
      <slot />
      {reason && <p class="reason">{reason}</p>}
    </div>
    <div class="example"><slot name="example" /></div>
  </div>
</section>

<style>
  .step-card {
    container-type: inline-size;
    margin-block: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .layout {
    display: grid;
    gap: var(--space-3);
  }

  @container (min-width: 36rem) {
    .layout {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-4);
    }
  }

  .example {
    align-self: start;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
    font-size: 1.125rem;
  }

  .number {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-background);
    font-size: 0.875rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .method :global(ul) {
    padding-inline-start: var(--space-4);
  }

  .method :global(:last-child) {
    margin-block-end: 0;
  }

  .reason {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
</style>
