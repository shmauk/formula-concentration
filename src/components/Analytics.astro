---
/**
 * The Cloudflare Web Analytics beacon: page views, referrers and countries
 * only. No custom events, and never anything from the calculator. Emitted
 * only when PUBLIC_CF_ANALYTICS_TOKEN is set at build time.
 */
const token = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

{
  token && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token })}
    />
  )
}
