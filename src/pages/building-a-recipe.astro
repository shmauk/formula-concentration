---
import Callout from "../components/tutorial/Callout.astro";
import Formula from "../components/tutorial/Formula.astro";
import ResultCard from "../components/tutorial/ResultCard.astro";
import StepCard from "../components/tutorial/StepCard.astro";
import TutorialPage from "../components/tutorial/TutorialPage.astro";
import WorkedExample from "../components/tutorial/WorkedExample.astro";
import { recipeWalkthrough } from "../content/building-a-recipe";
import { aptamilGoldPlus1, describeLabel, workedExamples } from "../content/worked-examples";
import { CONCENTRATION_WARNING_THRESHOLD, SUGGESTION_MAX_VOLUME_DIFFERENCE } from "../lib";

// Both walkthroughs make the same bottle. Every number below comes from the
// label values via the Recipe maths module.
const target = { volume: 150, concentration: 24 };

const examples = workedExamples.map((example) => ({
  ...example,
  label: describeLabel(example),
  working: recipeWalkthrough(example, target),
}));

const followAlong = examples.map((example) => ({
  id: example.id,
  name: example.name,
  summary: example.working.summary,
}));

// A case where one fewer Scoop lands too far from the Target volume.
const noSuggestionTarget = { volume: 150, concentration: 20 };
const noSuggestion = recipeWalkthrough(aptamilGoldPlus1, noSuggestionTarget);
if (!noSuggestion.oneFewerScoop || noSuggestion.oneFewerScoop.used) {
  throw new Error("The no-suggestion example now gives a Fewer-Scoops suggestion");
}
const noSuggestionFewer = noSuggestion.oneFewerScoop;
---

<TutorialPage
  title="Building a Recipe"
  lede="Make a bottle at a Target concentration by hand, from whole Scoops and water to the nearest 5 mL. The calculator does the same sums."
  followAlong={followAlong}
  nextLinks={[
    { href: "/calculator", label: "Open the calculator" },
    { href: "/reading-labels", label: "Back: Reading labels" },
  ]}
>
  <Fragment slot="intro">
    <p>
      You need the formula's <strong>Kcal per scoop</strong> and <strong
        >Displacement</strong
      >. <a href="/reading-labels">Reading labels</a> shows how to get them from
      the label.
    </p>
  </Fragment>

  <StepCard
    number={1}
    title="How many Scoops"
    reason="You can only use whole Scoops, and rounding up makes sure there's enough energy."
  >
    <Formula>
      <p>kcal/mL = Target concentration ÷ 30</p>
      <p>kcal needed = Target volume × kcal/mL</p>
      <p>Scoops = kcal needed ÷ Kcal per scoop, <strong>rounded up</strong></p>
    </Formula>
    <Fragment slot="example">
      {
        examples.map(({ working, ...example }) => (
          <WorkedExample example={example}>
            <p>
              <span class="term">kcal/mL:</span> {working.kcalPerMl}
            </p>
            <p>
              <span class="term">kcal needed:</span> {working.kcalNeeded}
            </p>
            <p>
              <span class="term">Scoops:</span> {working.scoops.working} →{" "}
              <strong>{working.scoops.value}</strong>
            </p>
          </WorkedExample>
        ))
      }
    </Fragment>
  </StepCard>

  <StepCard
    number={2}
    title="How much water"
    reason="The powder takes up room too, so the water is the volume that dilutes the energy back to target, less the powder's Displacement."
  >
    <Formula>
      <p>Actual kcal = Scoops × Kcal per scoop</p>
      <p>total Displacement = Scoops × Displacement</p>
      <p>
        water = Actual kcal ÷ kcal/mL − total Displacement, <strong
          >rounded up to the nearest 5 mL</strong
        >
      </p>
    </Formula>
    <Fragment slot="example">
      {
        examples.map(({ working, ...example }) => (
          <WorkedExample example={example}>
            <p>
              <span class="term">Actual kcal:</span> {working.actualKcal.working}
            </p>
            <p>
              <span class="term">Total Displacement:</span>{" "}
              {working.totalDisplacement.working} mL
            </p>
            <p>
              <span class="term">Water:</span> {working.water.working} →{" "}
              <strong>{working.water.value} mL</strong>
            </p>
          </WorkedExample>
        ))
      }
    </Fragment>
  </StepCard>

  <StepCard
    number={3}
    title="What you actually get"
    reason="Rounding means the bottle isn't exactly what you asked for; this tells you what it is."
  >
    <Formula>
      <p>Actual volume = water + total Displacement</p>
      <p>Actual concentration = Actual kcal ÷ Actual volume × 30</p>
    </Formula>
    <Fragment slot="example">
      {
        examples.map(({ working, ...example }) => (
          <WorkedExample example={example}>
            <p>
              <span class="term">Actual volume:</span>{" "}
              {working.actualVolume.working} mL
            </p>
            <p>
              <span class="term">Actual concentration:</span>{" "}
              {working.actualConcentration.working}
            </p>
          </WorkedExample>
        ))
      }
    </Fragment>
  </StepCard>

  {
    examples.map((example) => (
      <ResultCard
        example={example}
        heading="Recipe"
        labelAccessed={example.label.labelAccessed}
      >
        {example.working.recipe}
        <p class="makes" slot="detail">{example.working.makes}</p>
      </ResultCard>
    ))
  }

  <Callout title="Rounding">
    <ul>
      <li>
        Water is rounded to 5 mL because that's the smallest amount you can
        measure reliably on bottle markings.
      </li>
      <li>
        If Scoops comes out exactly whole, don't round up; the same goes for
        water already on a 5 mL mark.
      </li>
      <li>
        Working is shown to 1 decimal place for kcal and volumes, and 2 for
        Concentration.
      </li>
    </ul>
  </Callout>

  <Callout title="Why is it slightly under?">
    <p>
      Rounding Scoops up adds extra energy. The water is then sized to dilute
      that energy back to the target, and rounding the water up to 5 mL dilutes
      it a little more. So the Actual concentration is always at or just below
      the Target concentration, and the Actual volume at or above the Target
      volume.
    </p>
    <p>
      The calculator warns when the result is{" "}
      {CONCENTRATION_WARNING_THRESHOLD}&nbsp;kcal/30 mL or more below target.
    </p>
  </Callout>

  <StepCard
    marker="✓"
    title="Optional final check: try one fewer Scoop"
    reason="This Recipe can make slightly less than the Target volume. Two fewer is never worth checking: the main Recipe overshoots by less than one Scoop's worth of volume, so two fewer always lands further away."
  >
    <Formula>
      <p>Redo “How much water” and “What you actually get” with one fewer Scoop.</p>
      <p>
        Use it if its Actual volume is <strong>closer</strong> to the Target volume{" "}
        <strong>and within {SUGGESTION_MAX_VOLUME_DIFFERENCE} mL</strong> of it.
      </p>
    </Formula>
    <Fragment slot="example">
      {
        examples.map(({ working, ...example }) => (
          <WorkedExample example={example}>
            {working.oneFewerScoop ? (
              <>
                <p>
                  <span class="term">One fewer Scoop:</span>{" "}
                  {working.oneFewerScoop.recipe} → {working.oneFewerScoop.makes}
                </p>
                <p>
                  <strong>{working.oneFewerScoop.used ? "Used" : "Not used"}</strong>:{" "}
                  {working.oneFewerScoop.fromTarget} vs {working.brief.fromTarget}.
                </p>
              </>
            ) : (
              <p>A single Scoop: there's no fewer to try.</p>
            )}
          </WorkedExample>
        ))
      }
    </Fragment>
  </StepCard>

  <section class="short-example">
    <h2>Short example: no suggestion</h2>
    <p>
      {aptamilGoldPlus1.name}, {noSuggestionTarget.volume} mL at {
        noSuggestionTarget.concentration
      } → <strong>{noSuggestion.brief.recipe}</strong> → {noSuggestion.brief.makes}.
      One fewer ({noSuggestionFewer.recipe} → {noSuggestionFewer.actualVolume} mL)
      is {noSuggestionFewer.fromTarget}, so it isn't used.
    </p>
  </section>

  <p class="note">
    This page covers quantities only. Preparation and hygiene (water first,
    level Scoops and so on) follow the tin's instructions and your local feeding
    protocols.
  </p>
</TutorialPage>

<style>
  .makes {
    margin-block-end: var(--space-2);
    font-size: 1.0625rem;
  }

  .short-example {
    margin-block: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .short-example h2 {
    margin-block-end: var(--space-2);
    font-size: 1.125rem;
  }

  .note {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
</style>
